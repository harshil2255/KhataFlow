# ==========================================
# KhataFlow Environment Configuration
# ==========================================

# Gnani.ai Speech AI Credentials
# Get your API key from https://api.vachana.ai or https://docs.gnani.ai
GNANI_API_KEY=your_gnani_api_key_here

# Groq API Credentials (Ultra-fast LLM Intent Engine)
# Also enables Groq Whisper STT fallback when GNANI_API_KEY is not configured.
# Get your API key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Speech-to-Text fallback policy
# When no cloud STT key is configured and Google Speech is unreachable, KhataFlow
# can return a clearly-labelled simulated transcript so the demo still works.
# Set to false to make STT fail closed with an explicit "no speech" message.
ALLOW_SIMULATED_STT=true

# Optional fully-offline STT model (no API key needed).
# Download a small Vosk model and point to it, or unpack under backend/models/:
#   https://alphacephei.com/vosk/models/vosk-model-small-en-in-0.4.zip
#   https://alphacephei.com/vosk/models/vosk-model-small-hi-0.22.zip
# VOSK_MODEL_PATH=C:\path\to\vosk-model-small-en-in-0.4

# Backend Server Configuration
HOST=0.0.0.0
PORT=8000
DATABASE_URL=sqlite+aiosqlite:///./khataflow.db

# Gnani STT & TTS Service Endpoints
GNANI_STT_WS_URL=wss://api.vachana.ai/stt/v3/stream
GNANI_TTS_WS_URL=wss://api.vachana.ai/api/v1/tts

# Fallback / Simulation Mode:
# When true or when keys are placeholders, KhataFlow automatically enables
# robust low-latency mock/synthetic Indic streaming STT & TTS alongside full Groq + SQLite
SIMULATION_MODE=false
